  m_text: "<size=120><color=#FFC847><b>MOMIAS DEL GRITO</b></color></size>\n\n\n<size=42>Un juego de</size>\n<size=56><b>Cristian E. Oropeza</b>  &  <b>Jose A. Balderas</b></size>\n\n\n\n<size=38><color=#FFEBA6>PROGRAMACION Y SISTEMAS</color></size>\n<size=50>Cristian Eduardo Oropeza</size>\n\n\n<size=38><color=#FFEBA6>ARTE, ANIMACION, AUDIO Y LEVEL DESIGN</color></size>\n<size=50>Jose Antonio Balderas Melchor</size>\n\n\n<size=38><color=#FFEBA6>MOTOR</color></size>\n<size=50>Unity 6.6 \u2014 URP 2D</size>\n\n\n<size=38><color=#FFEBA6>ASISTENCIA TECNICA</color></size>\n<size=50>Claude (Anthropic)</size>\n\n\n<size=38><color=#FFEBA6>PROYECTO ACADEMICO</color></size>\n<size=46>Creacion de Videojuegos</size>\n<size=42>Universidad de Guanajuato \u2014 2026</size>\n\n\n\n<size=60><color=#FFC847>Gracias por jugar</color> \U0001F514</size>"
